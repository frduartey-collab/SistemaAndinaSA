# Copia como .env. Genera JWT_SECRET privado de al menos 32 bytes.
JWT_SECRET=
PORT=3000
DB_PATH=backend/data/app.db
# DEMO local. Seed es idempotente: no reemplaza usuarios existentes.
# El servidor crea SUPERVISOR 11111111-1/admin123 si aún no existe.
# Para crear otro usuario con npm run seed, cambia estos valores opcionales.
SEED_RUT=11111111-1
SEED_ROL=SUPERVISOR
SEED_PASSWORD=admin123
