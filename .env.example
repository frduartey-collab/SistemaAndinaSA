# npm run env:local genera un .env privado para desarrollo. Render usa render.yaml.
# Usa NODE_ENV=production en el servidor público. Render entrega PORT automáticamente.
NODE_ENV=development
PORT=3000
DB_PATH=backend/data/app.db
UPLOADS_DIR=backend/data/uploads

# Clave privada de al menos 32 bytes. Obligatoria en producción.
# Si se omite en desarrollo, las sesiones locales caducan al reiniciar.
JWT_SECRET=

# Demo: necesarias solo con una base vacía. Cinco claves diferentes de 16 a 72 bytes.
# En Render se generan y consultan en Environment. Cambiarlas no reemplaza el hash existente.
DEMO_PASSWORD_SUPERVISOR=
DEMO_PASSWORD_TECNICO=
DEMO_PASSWORD_TRABAJADOR=
DEMO_PASSWORD_BODEGA=
DEMO_PASSWORD_JEFATURA=

# Opcional: npm run seed agrega una cuenta individual al cliente inicial.
# Configura SEED_PASSWORD (16 a 72 bytes) solo si usas este comando.
# SEED_RUT=11111111-1
# SEED_ROL=SUPERVISOR
# SEED_PASSWORD=

# Integración de pagos opcional. Los pagos simulados están desactivados por defecto.
SIGEM_PAGOS_SIMULADOS=0
# SIGEM_WEBHOOK_PAGO_SECRET=
