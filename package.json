{
  "name": "sistema-andina-sa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project backend/tsconfig.json",
    "test": "npm run build && node --test backend/tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env backend/dist/server.js",
    "dev": "npm run build && npm start",
    "seed": "npm run build && node --env-file-if-exists=.env backend/dist/seed.js",
    "validate:contracts": "node scripts/validar-contratos.mjs"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "supertest": "7.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcrypt": "6.0.0",
    "better-sqlite3": "13.1.1",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
